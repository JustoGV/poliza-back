# =============================================================================
# MF Seguros — API — variables de entorno
# Copiar a `.env` y completar. La API NO arranca si falta una variable
# requerida (validación Zod en src/config).
# =============================================================================

# --- Entorno ----------------------------------------------------------------
NODE_ENV=development
API_PORT=3001
API_PREFIX=api
CORS_ORIGINS=http://localhost:3000

# --- Base de datos ----------------------------------------------------------
POSTGRES_USER=mfseguros
POSTGRES_PASSWORD=mfseguros_dev
POSTGRES_DB=mfseguros
# Puertos corridos de los default a propósito. Si otro contenedor ya publica
# 5432, Docker NO falla: levanta el nuestro sin publicar el puerto y la app
# termina hablando con la base equivocada. Verificar con:
#   docker ps --format "{{.Names}}\t{{.Ports}}"
POSTGRES_PORT=5433
DATABASE_URL=postgresql://mfseguros:mfseguros_dev@localhost:5433/mfseguros?schema=public

# --- Redis / BullMQ ---------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6380
REDIS_PASSWORD=
INGESTA_JOB_ATTEMPTS=3
INGESTA_JOB_BACKOFF_MS=5000

# --- Almacenamiento de archivos (MinIO / S3) --------------------------------
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_USE_SSL=false
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_BUCKET=importaciones

# --- Autenticación ----------------------------------------------------------
# Generar con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=cambiar_en_produccion_minimo_64_caracteres_aleatorios_reales_aca
JWT_REFRESH_SECRET=otro_secreto_distinto_al_de_access_tambien_64_caracteres_minimo
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
REFRESH_COOKIE_NAME=mf_rt
REFRESH_COOKIE_SECURE=false
REFRESH_COOKIE_DOMAIN=localhost

# --- Rate limiting ----------------------------------------------------------
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=120
THROTTLE_LOGIN_TTL_MS=900000
THROTTLE_LOGIN_LIMIT=5

# --- Ingesta / ETL ----------------------------------------------------------
UPLOAD_MAX_BYTES=20971520
INGESTA_BATCH_SIZE=500

# --- Motor de homologación (decisiones abiertas, ver docs/MAPA_CANONICO.md) --
HOMOLOGACION_FUZZY_THRESHOLD=0.75
REHOMOLOGACION_INLINE_MAX=500
RENOVACION_VENTANA_DIAS=60
FEATURE_DATOS_FINANCIEROS=false

# --- Observabilidad ---------------------------------------------------------
LOG_LEVEL=debug
LOG_FORMAT=pretty
